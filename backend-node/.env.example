# Set to True only in local development: it relaxes CORS and returns stack
# traces in error responses.
DEBUG=False

# Where the API listens. nginx proxies /api/ here.
HOST=127.0.0.1
PORT=8000

# Postgres. Prisma needs DATABASE_URL; the individual DATABASE_* variables from
# the old Django .env are also accepted and assembled into one automatically.
DATABASE_URL=postgresql://ayerkie_prod:changeme@127.0.0.1:5432/ayerkie_prod

# Public origin of the storefront, used for links inside emails and SMS.
SITE_URL=https://croppedbyayerkie.com

# Browsers allowed to call the API. Not needed when nginx serves the frontend
# and the API from the same domain.
CORS_ALLOWED_ORIGINS=https://croppedbyayerkie.com,https://www.croppedbyayerkie.com

# Uploaded product images, relative to backend-node/ or an absolute path.
# Point this at the directory the Django backend was using.
MEDIA_ROOT=media
# Uploads are resized to fit this box and stored as WebP at this quality.
IMAGE_MAX_DIMENSION=1200
IMAGE_WEBP_QUALITY=82

# Email (Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cropped By Ayerkie Store <your-email@gmail.com>
ADMIN_EMAIL=

# SMS (Africa's Talking) — use production credentials, not sandbox
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=

# Shown to customers in the cancellation SMS
SUPPORT_PHONE_NUMBER=+233 24 123 4567

# Admin sessions and login lockout
ADMIN_TOKEN_LIFETIME_HOURS=24
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
VERIFICATION_CODE_MINUTES=10

# Iteration count for newly set passwords. Verifying an existing password uses
# whatever count is recorded in its own hash, so changing this is always safe.
PBKDF2_ITERATIONS=720000
